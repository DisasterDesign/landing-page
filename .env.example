# Database
DATABASE_URL="postgresql://user:password@host:5432/fuzionwebz?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/fuzionwebz?sslmode=require"

# Auth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://www.fuzionwebz.com"

# Seed
SEED_ADMIN_PASSWORD="change-me-in-production"

# Public
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# Meta (Facebook) Pixel — Events Manager → Data Sources → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=""
# LinkedIn Insight Tag — Campaign Manager → Analyze → Insight Tag → Partner ID
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""
NEXT_PUBLIC_WHATSAPP_NUMBER="972547136666"
NEXT_PUBLIC_WHATSAPP_MESSAGE="היי, אשמח לשמוע עוד על השירותים שלכם!"
NEXT_PUBLIC_SITE_URL="https://fuzionwebz.com"
NEXT_PUBLIC_SITE_NAME="Fuzion Webz"

# Google integration (Search Console + Analytics 4)
# Generate with: openssl rand -base64 32
OAUTH_ENCRYPTION_KEY="generate-32-byte-random-key"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://www.fuzionwebz.com/api/seo/callback"

# Facebook Lead Ads
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://www.fuzionwebz.com/api/integrations/facebook/callback"
# Generate with: openssl rand -hex 24
META_WEBHOOK_VERIFY_TOKEN=""

# Cardcom payment integration
# Get from https://secure.cardcom.solutions/ → API settings
CARDCOM_TERMINAL=""
CARDCOM_API_NAME=""
CARDCOM_API_PASSWORD=""
CARDCOM_BILLGOLD_USERNAME=""
CARDCOM_BILLGOLD_PASSWORD=""

# Cron authorization — Vercel injects this as a Bearer automatically on cron
# invocations; without it, cron routes only accept the vercel-cron user-agent.
CRON_SECRET=

# Shared secret for Cardcom's recurring-payments webhook ("דיווח למערכת
# חיצונית" in the dashboard). Payloads with a mismatching Secret are rejected.
CARDCOM_RECURRING_WEBHOOK_SECRET=

# Google Places API (New) — powers the homepage Google-reviews section.
# Created in Google Cloud Console: enable "Places API (New)" + API key.
# Missing key = the section silently doesn't render.
GOOGLE_PLACES_API_KEY=

# Weekly cold prospecting — isolated provider keys and disabled by default.
PROSPECTING_ENABLED=false
PROSPECTING_AI_API_KEY=
PROSPECTING_AI_MODEL=
PROSPECTING_GOOGLE_PLACES_API_KEY=
PROSPECTING_PAGESPEED_API_KEY=
PROSPECTING_HASH_SECRET=
PROSPECTING_WEEKLY_TARGET=50
PROSPECTING_MAX_DISCOVERED_PER_CYCLE=250
PROSPECTING_MAX_PLACES_CALLS_PER_CYCLE=400
PROSPECTING_MAX_AI_CALLS_PER_CYCLE=250
PROSPECTING_MAX_ESTIMATED_COST_USD=25

# Unified commercial Lead lifecycle — server-side rollout flags.
UNIFIED_LEAD_LIFECYCLE_ENABLED=false
COLD_LEAD_PREPARATION_ENABLED=false
INBOUND_LEAD_SLA_MINUTES=5
AD_RESPONSE_LEAD_SLA_MINUTES=15
