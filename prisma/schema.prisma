model GoogleIntegration {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String?
  accessToken   String // AES-256-GCM encrypted
  refreshToken  String // AES-256-GCM encrypted
  expiresAt     DateTime
  scopes        String[]
  gscSiteUrl    String?
  ga4PropertyId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SeoSnapshot {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  totalClicks      Int      @default(0)
  totalImpressions Int      @default(0)
  avgCtr           Float    @default(0)
  avgPosition      Float    @default(0)
  organicSessions  Int      @default(0)
  referralSessions Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([date])
  @@index([date])
}

model SeoQuery {
  id          String   @id @default(cuid())
  query       String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  topPage     String?
  windowStart DateTime @db.Date
  windowEnd   DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([query, windowStart])
  @@index([clicks])
  @@index([impressions])
  @@index([position])
}

model Backlink {
  id           String   @id @default(cuid())
  sourceDomain String
  targetUrl    String
  firstSeen    DateTime
  lastSeen     DateTime @updatedAt

  @@unique([sourceDomain, targetUrl])
  @@index([sourceDomain])
}

model UtmLink {
  id        String   @id @default(cuid())
  fullUrl   String
  baseUrl   String
  source    String
  medium    String
  campaign  String
  term      String?
  content   String?
  label     String?
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  createdBy     String
  createdByUser User   @relation(fields: [createdBy], references: [id])

  @@index([createdAt])
  @@index([createdBy])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model FacebookIntegration {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId          String    @unique
  pageName        String
  pageAccessToken String // AES-256-GCM encrypted
  subscribedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

// Small generic key→JSON store. First use: the Cardcom terminal-wide debtors
// snapshot the reconcile cron diffs between runs (alert on new/grown debt
// only, not on every retry attempt — collection retries run several times a
// week and would flood the notifications).
model KeyValue {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
