generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentStatus {
  PENDING
  SENT
  COMPLETED
  FAILED
  CANCELLED
}

enum LicenseType {
  PERSONAL
  COMMERCIAL
}

enum AgreementTier {
  BASIC
  ADVANCED
  PREMIUM
}

enum AgreementStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMMENTED
  CONTACT_RECEIVED
  AGREEMENT_SIGNED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  CLOSED
  SPAM
}

enum BlogPostStatus {
  DRAFT
  READY
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(MEMBER)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTasks Task[]   @relation("TaskAssignees")
  createdTasks  Task[]   @relation("CreatedTasks")
  comments      Comment[]
  blogPosts     BlogPost[]
  notifications Notification[] @relation("NotificationRecipient")
  googleIntegration GoogleIntegration?
  facebookIntegrations FacebookIntegration[]
  utmLinks      UtmLink[]
  pushSubscriptions PushSubscription[]
  contactNotes  ContactNote[]
  clientNotes   ClientNote[] @relation("ClientNoteAuthor")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  client      String?
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks Task[]
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  order       Int        @default(0)
  tags        String[]

  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])

  assignees User[] @relation("TaskAssignees")

  creatorId String
  creator   User     @relation("CreatedTasks", fields: [creatorId], references: [id])

  comments      Comment[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([projectId])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  body        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

model Comment {
  id      String @id @default(cuid())
  content String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
}

model ContactSubmission {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String?
  company         String?
  message         String
  service         String?
  isRead          Boolean       @default(false)
  status          ContactStatus @default(NEW)
  tags            String[]
  source             String?
  externalLeadId     String?       @unique
  externalFormId     String?
  externalFormName   String?
  externalCampaignId String?
  externalAdId       String?
  nextFollowUpAt     DateTime?
  lastContactedAt    DateTime?
  createdAt          DateTime      @default(now())

  notes ContactNote[]

  @@index([isRead])
  @@index([status])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   ContactSubmission @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
}

// ==================
// BLOG
// ==================

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    // Rich HTML from TipTap
  coverImage  String?
  category    String?
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  metaTitle   String?
  metaDesc    String?

  scheduledAt    DateTime?
  status         BlogPostStatus @default(DRAFT)
  targetKeyword  String?
  keywords       String[]
  contentScore   Int?
  lastReviewedAt DateTime?
  reviewNotes    String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
  @@index([category])
  @@index([status, scheduledAt])
}

// ==================
// FONT STORE
// ==================

model FontFamily {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  designer    String?
  previewUrl  String?
  category    String?  // serif, sans, display, script, mono
  tags        String[]
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  styles FontStyle[]
  orders FontOrder[]

  @@index([published])
}

model FontStyle {
  id              String @id @default(cuid())
  name            String // "Regular", "Bold", "Light"
  weight          Int    @default(400)
  fontFileUrl     String // Path to downloadable font file
  previewUrl      String?
  pricePersonal   Float  @default(0)
  priceCommercial Float  @default(0)

  fontFamilyId String
  fontFamily   FontFamily @relation(fields: [fontFamilyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id           String    @id @default(cuid())
  number       Int       @default(autoincrement())
  name         String
  status       String    @default("")
  notes        String?
  amount       Float?
  expense      Float?
  cardcomFee   Float?
  websiteUrl   String?
  // Contact / business identity (added for Client Card)
  email        String?
  phone        String?
  businessName String?
  idNumber     String?
  source       String?   // "agreement_signed" | "manual" | "lead_converted" | "import"
  archivedAt   DateTime?
  startDate    DateTime?
  paymentDate  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agreements    Agreement[]
  clientNotes   ClientNote[]

  @@index([number])
  @@index([email])
  @@index([phone])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ClientNoteAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model Agreement {
  id                 String          @id @default(cuid())
  tier               AgreementTier?  // base tier (required for new agreements; nullable for legacy rows)
  additionalServices String[]        @default([])  // extra service clauses appended to the tier base list
  monthlyPrice       Float           // editable by creator; defaults to tier price when tier is picked
  oneTimeFee         Float?          // optional setup fee
  customerName    String
  businessName    String?
  idNumber        String?
  phone           String
  email           String
  status          AgreementStatus @default(DRAFT)
  signedAt        DateTime?
  signatureData   String?
  content         String
  signToken       String          @unique @default(cuid())
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  // Legal trail captured at signing
  signedIp        String?
  signedUserAgent String?
  documentVersion Int             @default(1)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  // Cardcom payment integration
  paymentStatus PaymentStatus @default(PENDING)
  paymentUrl    String?       // LowProfile checkout URL returned by Cardcom
  paymentId     String?       // Cardcom LowProfileId (per-attempt)
  cardcomDealId String?       // Cardcom InternalDealNumber after successful charge
  cardcomToken  String?       // Token for future recurring charges
  cardcomRecurringId Int?     // Cardcom's ID for the recurring schedule (BillGoldService)
  cardcomLowProfileId String? // LowProfile GUID — used to create recurring order via Name-to-Value API
  cardcomAccountId   Int?     // Cardcom account ID returned after recurring creation
  invoiceNumber String?       // Cardcom invoice number, if generated
  paidAt        DateTime?
  paidAmount    Float?

  charges       AgreementCharge[]

  @@index([status])
  @@index([clientId])
  @@index([signToken])
  @@index([paymentStatus])
}

model AgreementCharge {
  id                 String    @id @default(cuid())
  agreementId        String
  agreement          Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  amount             Float
  cardcomDealId      String?   // InternalDealNumber for this specific charge (unique per Cardcom deal)
  invoiceNumber      String?   // DocumentNumber (חשבונית מס)
  cardcomRecurringId Int?      // null for the first/LowProfile charge; populated for recurring auto-charges
  success            Boolean   @default(true)
  chargedAt          DateTime  @default(now())
  rawPayload         Json?     // raw webhook body for debugging

  @@index([agreementId, chargedAt])
  @@index([cardcomDealId])
}

model FontOrder {
  id            String        @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String?
  licenseType   LicenseType
  totalPrice    Float
  currency      String        @default("ILS")
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?       // CardCom transaction ID
  downloadToken String?       @unique
  downloadCount Int           @default(0)

  expiresAt     DateTime?
  downloadedAt  DateTime?

  fontFamilyId String
  fontFamily   FontFamily @relation(fields: [fontFamilyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ==================
// SEO / GOOGLE
// ==================

model GoogleIntegration {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String?
  accessToken   String   // AES-256-GCM encrypted
  refreshToken  String   // AES-256-GCM encrypted
  expiresAt     DateTime
  scopes        String[]
  gscSiteUrl    String?
  ga4PropertyId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SeoSnapshot {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  totalClicks      Int      @default(0)
  totalImpressions Int      @default(0)
  avgCtr           Float    @default(0)
  avgPosition      Float    @default(0)
  organicSessions  Int      @default(0)
  referralSessions Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([date])
  @@index([date])
}

model SeoQuery {
  id          String   @id @default(cuid())
  query       String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  topPage     String?
  windowStart DateTime @db.Date
  windowEnd   DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([query, windowStart])
  @@index([clicks])
  @@index([impressions])
  @@index([position])
}

model Backlink {
  id           String   @id @default(cuid())
  sourceDomain String
  targetUrl    String
  firstSeen    DateTime
  lastSeen     DateTime @updatedAt

  @@unique([sourceDomain, targetUrl])
  @@index([sourceDomain])
}

model UtmLink {
  id         String   @id @default(cuid())
  fullUrl    String
  baseUrl    String
  source     String
  medium     String
  campaign   String
  term       String?
  content    String?
  label      String?
  clicks     Int      @default(0)
  createdAt  DateTime @default(now())

  createdBy   String
  createdByUser User    @relation(fields: [createdBy], references: [id])

  @@index([createdAt])
  @@index([createdBy])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model FacebookIntegration {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId            String   @unique
  pageName          String
  pageAccessToken   String   // AES-256-GCM encrypted
  subscribedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}
